# ---------------------------------------------------------------- UOTP API
# Required. Without it the bot refuses to start rather than failing later
# with a confusing error on the first order. This file is gitignored -- never
# commit a real key.
UOTP_API_KEY=

# handler_api.php protocol: every call is a GET with the action and the key in
# the query string, and responses are plain text of the form PREFIX:field:field
#   ACCESS_BALANCE:0
#   ACCESS_NUMBER:12345:+919876543210
#   STATUS_OK:482193
# Verified against the live endpoint on 2026-09-02.
UOTP_BASE_URL=https://uotp.store/api/stubs/handler_api.php
UOTP_TIMEOUT=30

# Query parameter names.
UOTP_KEY_PARAM=api_key
UOTP_ACTION_PARAM=action

# Action names. Only getBalance is documented by the provider; the rest follow
# the conventions of this protocol family. If the provider names them
# differently, change them here -- no code change needed.
UOTP_ACTION_BALANCE=getBalance
UOTP_ACTION_PRICES=getPrices
UOTP_ACTION_GET_NUMBER=getNumber
UOTP_ACTION_GET_STATUS=getStatus
UOTP_ACTION_SET_STATUS=setStatus
UOTP_ACTION_ACTIVE=getActiveActivations

# Response prefixes.
UOTP_PREFIX_BALANCE=ACCESS_BALANCE
UOTP_PREFIX_NUMBER=ACCESS_NUMBER
UOTP_PREFIX_CANCEL=ACCESS_CANCEL
UOTP_PREFIX_OK=STATUS_OK
UOTP_PREFIX_WAIT=STATUS_WAIT_CODE
UOTP_PREFIX_RESEND=STATUS_WAIT_RESEND
UOTP_PREFIX_CANCELED=STATUS_CANCEL

# setStatus codes: 6 completes an activation, 8 cancels it.
UOTP_STATUS_COMPLETE=6
UOTP_STATUS_CANCEL=8

# getPrices is observed to require BOTH of these (a bare call returns
# BAD_COUNTRY; country alone returns BAD_OPERATOR). Their exact meaning is
# provider-specific and undocumented, so try values from the provider's own
# dashboard and record what works.
# Live-tested 2026-09-02: country 0 and 1 pass validation, operator numeric
# ids >= 2 pass, then the provider's own backend returns NO_CONNECTION (their
# DB was down). Keep these values; retry getPrices until it answers, then
# let it replace src/uotpbot/data/uotp_prices.csv.
UOTP_PRICES_COUNTRY=0
UOTP_PRICES_OPERATOR=2

# getNumber rejected "whatsapp" with BAD_SERVICE, so the provider uses its own
# slug vocabulary. Map ours to theirs once known:
#   UOTP_SERVICE_MAP=whatsapp=wa,telegram=tg,google=go
# Empty means slugs pass through unchanged.
UOTP_SERVICE_MAP=

# Units. UOTP prices publicly in rupees, so this defaults to 1. If getBalance
# ever returns 100000 where the dashboard shows Rs.1000, set it to 100. Getting
# this wrong is a 100x error, which is why it is a named setting and not a guess.
UOTP_BALANCE_DIVISOR=1

# ------------------------------------------------------------------- fees
# Payment gateway charge on a sale. UPI is near zero; cards are ~2%.
FEE_GATEWAY_RATE=0.02
FEE_GATEWAY_FIXED=0
# GST charged on the gateway's own fee.
FEE_GATEWAY_GST=0.18
# Output GST on your sales. 0.18 once GST-registered, 0 below the threshold.
FEE_GST_RATE=0
# True = your advertised price already includes GST. False = GST is added on top.
FEE_GST_INCLUSIVE=true
# Share of delivered orders customers dispute anyway. Pure loss: you refund
# the sale but the number is already consumed.
FEE_CHARGEBACK_RATE=0

# ----------------------------------------------------------------- engine
# Max numbers bought for one order. Costs rise linearly with this, and it does
# NOT lower cost per delivery -- see tests/test_economics.py.
ENGINE_RETRY_CAP=3
# UOTP refunds only if no OTP arrives within 5 minutes, so do not wait longer
# than that or you forfeit the refund.
ENGINE_OTP_TIMEOUT=290
ENGINE_POLL_INTERVAL=3
ENGINE_AUTO_REFUND=true
# Top the provider wallet up to this multiple of the order price when empty.
ENGINE_TOPUP_HEADROOM=5
ENGINE_DEFAULT_COUNTRY=in

# ---------------------------------------------------------------- telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Comma-separated Telegram user IDs allowed to use the bot. Empty = anyone.
TELEGRAM_ALLOWED_USERS=

# ------------------------------------------------------------------ storage
# Postgres (Supabase). When set, BOTH the ledger and the sub-bot registry use
# it and the sqlite paths below are ignored. Use the SESSION pooler
# (port 5432): the direct db.<ref>.supabase.co host is IPv6-only, and the
# transaction pooler (6543) serves a long-lived bot no better.
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DATABASE_SCHEMA=uotp

# Fallback when DATABASE_URL is unset: sqlite files. On a host with an
# ephemeral filesystem (e.g. a Render free container) these are wiped on every
# deploy -- on paid plans point them at a mounted disk (/var/data/...).
LEDGER_PATH=ledger.db
# Leave unset to use the bundled src/uotpbot/data/uotp_prices.csv.
PRICES_PATH=

# -------------------------------------------------------------- white-label
# "Create your own bot": owners paste a bot token and run a clone of this bot.
# Off by default so an existing deployment does not start spawning pollers.
WHITELABEL_ENABLED=false
# Sub-bot records (token, mode, and the fee terms the owner agreed to).
# Ignored when DATABASE_URL is set (the registry then lives in Postgres next
# to the ledger). With sqlite: put this on the SAME persistent disk as
# LEDGER_PATH -- a registry that survives a redeploy while the ledger does not
# would keep charging fees it can no longer account for.
SUBBOTS_PATH=subbots.db

# The platform's cut of a sale made by an OWN_API sub-bot, and it is always
# disclosed to the owner before their bot is created and recorded against it.
# PLATFORM_API sub-bots pay no percentage: the platform already earns the
# spread built into the wholesale number price, and charging both would be
# double dipping on the same rupee.
PLATFORM_FEE_RATE=0.05

# Your profit margin over true cost when pricing services (the main bot's
# margin). 0.10 = keep ~10% of each sale after provider cost, retries,
# gateway fee and GST. Distinct from FEE_GATEWAY_RATE (a cost the PSP charges
# you) and PLATFORM_FEE_RATE (your cut of white-label owners' sales).
PRICING_TARGET_MARGIN=0.35

# Who customers message to add money to their wallet, e.g. "@yourhandle" or
# "https://t.me/yourhandle". Shown on the bot's 💰 Balance screen.
# Leave empty to show "the bot owner".
#SUPPORT_CONTACT=
